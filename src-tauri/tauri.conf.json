{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "game-schedule",
  "version": "0.1.0",
  "identifier": "com.maks-zhukov.game-schedule",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
  {
    "title": "Игровое Расписание",
    "width": 360,
    "height": 640,
    "resizable": true,
    "center": true,
    "decorations": true
  }
]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
